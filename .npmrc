# This project is pnpm-only — see "packageManager" in package.json.
# npm-specific settings were removed: npm is never used here, and it warned on
# every invocation about keys it did not recognise.

# pnpm runs pre/post scripts by default, but these two carry real weight:
# `prebuild` is the guard that stops a stripped admin import map from shipping
# (scripts/assert-importmap.mjs — a blank prod admin), and `postbuild` builds
# the sitemap. Stated explicitly so a future change of default cannot quietly
# drop either one.
enable-pre-post-scripts=true
