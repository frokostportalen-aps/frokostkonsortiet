{
  "name": "frokost-konsortiet",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "prebuild": "node scripts/assert-importmap.mjs",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env R2_BUCKET=placeholder NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm install",
    "seed:tenants": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-tenants.ts",
    "seed:tenants:prod": "cross-env NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.production tsx scripts/seed-tenants.ts",
    "prune:media": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/prune-media.ts",
    "prune:media:prod": "cross-env NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.production tsx scripts/prune-media.ts",
    "prune:versions": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/prune-versions.ts",
    "prune:versions:prod": "cross-env NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.production tsx scripts/prune-versions.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.89.0",
    "@payloadcms/db-mongodb": "3.89.0",
    "@payloadcms/email-resend": "3.89.0",
    "@payloadcms/live-preview-react": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/plugin-form-builder": "3.89.0",
    "@payloadcms/plugin-multi-tenant": "3.89.0",
    "@payloadcms/plugin-nested-docs": "3.89.0",
    "@payloadcms/plugin-redirects": "3.89.0",
    "@payloadcms/plugin-search": "3.89.0",
    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.6.1",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-sitemap": "^4.2.3",
    "payload": "3.89.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.5.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^12"
  }
}
